<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows voice project (Whisper.net, Kokoro, sherpa-onnx), compiled from windows/src/AL76.Speech (read-only). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AL76.Speech</RootNamespace>
    <AssemblyName>AL76.Speech</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(WindowsSrc)AL76.Speech/**/*.cs" Exclude="$(WindowsSrc)AL76.Speech/obj/**;$(WindowsSrc)AL76.Speech/bin/**" LinkBase="speech" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AL76.Core/AL76.Core.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
  </ItemGroup>
</Project>
