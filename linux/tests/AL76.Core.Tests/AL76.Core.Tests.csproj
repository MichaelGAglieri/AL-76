<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows core tests (windows/tests/AL76.Core.Tests, read-only), run on Linux against the same core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(WindowsTests)AL76.Core.Tests/**/*.cs" Exclude="$(WindowsTests)AL76.Core.Tests/obj/**;$(WindowsTests)AL76.Core.Tests/bin/**" LinkBase="core-tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Shared/AL76.Core/AL76.Core.csproj" />
    <ProjectReference Include="../../src/Shared/AL76.Speech/AL76.Speech.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
