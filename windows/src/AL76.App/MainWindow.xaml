<Window x:Class="AL76.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AL-76" Width="520" Height="640" MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Back}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Wheel">
        <StackPanel Margin="28,24">
            <TextBlock x:Name="NameText" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="Phase" Foreground="{StaticResource Dim}" Margin="0,2,0,6"/>
            <TextBlock x:Name="Running" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Border x:Name="Warning" Background="#33F5B638" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="WarningText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="VoiceTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="VoiceStatus" TextWrapping="Wrap" Margin="0,2"/>
                    <ProgressBar x:Name="VoiceLevel" Height="4" Maximum="0.15" Margin="0,6" Foreground="{StaticResource Accent}" Background="#22FFFFFF" BorderThickness="0"/>
                    <TextBlock x:Name="VoiceDetail" TextWrapping="Wrap" Foreground="{StaticResource Dim}" Margin="0,2"/>
                    <TextBlock x:Name="VoiceLast" TextWrapping="Wrap" Margin="0,2"/>
                </StackPanel>
            </Border>
            <StackPanel x:Name="Sections"/>
        </StackPanel>
    </ScrollViewer>
</Window>
