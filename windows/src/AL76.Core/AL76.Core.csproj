<Project Sdk="Microsoft.NET.Sdk">
  <!-- Logic with no Windows API: it builds and is tested on the Mac too. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AL76.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="locales/*.json" LogicalName="locales.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="PdfPig" Version="0.1.13" />
  </ItemGroup>
</Project>
